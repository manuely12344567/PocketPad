<Window x:Class="PocketPad.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PocketPad.Windows.Controls"
        Title="PocketPad v1.2.0 — Manette Multijoueur &amp; Mode Écran Switch (USB · Bluetooth · Wi-Fi)"
        Width="1160" Height="790"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgRoot}"
        Icon="Assets/icon.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,11" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/icon.png" Width="38" Height="38" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PocketPad" Foreground="{StaticResource TextPrimary}" FontSize="19" FontWeight="Bold" />
                            <Border Background="#172554" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.2.0 · MODE SWITCH 4J" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="1–4 joueurs simultanés · Écran du jeu en direct sur chaque téléphone + Split-Screen J1–J4 · USB, Bluetooth &amp; Wi-Fi"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <!-- Active Video + Multiplayer Counter Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="VideoPill" Background="#172554" BorderBrush="#2563EB" BorderThickness="1"
                            CornerRadius="18" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="OnOpenSwitchTabClick"
                            ToolTip="Clique pour ouvrir les réglages Écran Switch &amp; Split-Screen">
                        <TextBlock x:Name="TxtHeaderVideo" Text="Écran Switch : Prêt" Foreground="#93C5FD" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="ConnectionBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="18" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedP1" Width="8" Height="8" Fill="#334155" Margin="0,0,4,0" ToolTip="Joueur 1" />
                            <Ellipse x:Name="LedP2" Width="8" Height="8" Fill="#334155" Margin="0,0,4,0" ToolTip="Joueur 2" />
                            <Ellipse x:Name="LedP3" Width="8" Height="8" Fill="#334155" Margin="0,0,4,0" ToolTip="Joueur 3" />
                            <Ellipse x:Name="LedP4" Width="8" Height="8" Fill="#334155" Margin="0,0,9,0" ToolTip="Joueur 4" />
                            <TextBlock x:Name="ConnectionLabel" Text="0 / 4 joueurs connectés"
                                       Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnDisconnectAll" Content="Tout déconnecter" Style="{StaticResource SecondaryButton}"
                            Click="OnDisconnectAllClick" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 2-COLUMN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.28*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.88*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: 4 PLAYER SLOTS + TAB SWITCHER + ACTIVE PANEL -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 4-PLAYER MULTIPLAYER SLOT STRIP -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- SLOT J1 -->
                    <Border x:Name="SlotCard1" Grid.Column="0" Background="#11182B" BorderBrush="#38BDF8" BorderThickness="1.8"
                            CornerRadius="12" Padding="10,8" Cursor="Hand" MouseLeftButtonUp="OnSelectSlot1">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#38BDF8" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock Text="J1" Foreground="#090D1A" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                    <Ellipse x:Name="SlotDot1" Width="7" Height="7" Fill="#475569" />
                                </StackPanel>
                                <TextBlock x:Name="SlotHz1" Text="—" Foreground="#64748B" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="SlotName1" Text="Libre" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,1" />
                            <TextBlock x:Name="SlotTransport1" Text="En attente" Foreground="#64748B" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- SLOT J2 -->
                    <Border x:Name="SlotCard2" Grid.Column="2" Background="#11182B" BorderBrush="#243150" BorderThickness="1.2"
                            CornerRadius="12" Padding="10,8" Cursor="Hand" MouseLeftButtonUp="OnSelectSlot2">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#A855F7" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock Text="J2" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                    <Ellipse x:Name="SlotDot2" Width="7" Height="7" Fill="#475569" />
                                </StackPanel>
                                <TextBlock x:Name="SlotHz2" Text="—" Foreground="#64748B" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="SlotName2" Text="Libre" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,1" />
                            <TextBlock x:Name="SlotTransport2" Text="En attente" Foreground="#64748B" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- SLOT J3 -->
                    <Border x:Name="SlotCard3" Grid.Column="4" Background="#11182B" BorderBrush="#243150" BorderThickness="1.2"
                            CornerRadius="12" Padding="10,8" Cursor="Hand" MouseLeftButtonUp="OnSelectSlot3">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#22C55E" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock Text="J3" Foreground="#090D1A" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                    <Ellipse x:Name="SlotDot3" Width="7" Height="7" Fill="#475569" />
                                </StackPanel>
                                <TextBlock x:Name="SlotHz3" Text="—" Foreground="#64748B" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="SlotName3" Text="Libre" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,1" />
                            <TextBlock x:Name="SlotTransport3" Text="En attente" Foreground="#64748B" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- SLOT J4 -->
                    <Border x:Name="SlotCard4" Grid.Column="6" Background="#11182B" BorderBrush="#243150" BorderThickness="1.2"
                            CornerRadius="12" Padding="10,8" Cursor="Hand" MouseLeftButtonUp="OnSelectSlot4">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F97316" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock Text="J4" Foreground="#090D1A" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                    <Ellipse x:Name="SlotDot4" Width="7" Height="7" Fill="#475569" />
                                </StackPanel>
                                <TextBlock x:Name="SlotHz4" Text="—" Foreground="#64748B" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="SlotName4" Text="Libre" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,1" />
                            <TextBlock x:Name="SlotTransport4" Text="En attente" Foreground="#64748B" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2-TAB WORKSPACE BAR -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnTabGamepad" Grid.Column="0" Content="Manette en direct &amp; Journal"
                            Style="{StaticResource PrimaryButton}" Padding="12,8" Click="OnTabGamepadClick" />
                    <Button x:Name="BtnTabSwitch" Grid.Column="2" Content="Mode Écran Switch &amp; Split-Screen (J1–J4)"
                            Style="{StaticResource SecondaryButton}" Padding="12,8" Click="OnTabSwitchClick" />
                </Grid>

                <!-- PANEL 1: GAMEPAD VISUALIZER + LOGS -->
                <Grid x:Name="PanelGamepad" Grid.Row="4" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- LIVE CONTROLLER CARD FOR SELECTED PLAYER -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtVisualizerTitle" Text="VISUALISEUR EN DIRECT · JOUEUR 1" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                                    <TextBlock x:Name="ActiveDeviceSubtitle" Text="Clique sur J1, J2, J3 ou J4 ci-dessus pour surveiller chaque joueur"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="BtnSwapSlot" Content="J1 ⇄ J2" Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="OnSwapSelectedSlotClick" IsEnabled="False"
                                            ToolTip="Échanger ce joueur avec le slot suivant (ex. J1 ↔ J2)" />
                                    <Button x:Name="BtnTestRumble" Content="Vibrer" Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="OnTestRumbleClick" IsEnabled="False" />
                                    <Button x:Name="BtnKickSlot" Content="Déconnecter" Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" FontSize="11.5" Click="OnKickSelectedSlotClick" IsEnabled="False" />
                                </StackPanel>
                            </Grid>

                            <controls:GamepadVisualizer x:Name="Visualizer" Height="200" />

                            <!-- Input Routing Mode Selector -->
                            <Border Background="#0D1426" BorderBrush="#1F2C4A" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="Mode d’entrée :" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <RadioButton x:Name="RbModeAuto" Content="Auto (Xbox + Clavier/Souris)" IsChecked="True"
                                                     Foreground="#F1F5F9" FontSize="11.5" Margin="0,0,12,0" Checked="OnModeChanged" />
                                        <RadioButton x:Name="RbModeXbox" Content="Xbox 360"
                                                     Foreground="#F1F5F9" FontSize="11.5" Margin="0,0,12,0" Checked="OnModeChanged" />
                                        <RadioButton x:Name="RbModeKb" Content="Clavier/Souris"
                                                     Foreground="#F1F5F9" FontSize="11.5" Checked="OnModeChanged" />
                                    </StackPanel>
                                    <CheckBox x:Name="CbKbPlayer1Only" Grid.Row="1" Margin="0,6,0,0"
                                              Content="Réserver le contrôle Clavier/Souris au Joueur 1 uniquement (évite les conflits de souris en multijoueur)"
                                              Foreground="#94A3B8" FontSize="11" Checked="OnKbOwnerToggleChanged" Unchecked="OnKbOwnerToggleChanged" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Live Log Console -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="JOURNAL MULTIJOUEUR EN DIRECT" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                <Button Content="Effacer" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"
                                        HorizontalAlignment="Right" Click="OnClearLogsClick" />
                            </Grid>
                            <TextBox x:Name="TxtLogs" Grid.Row="1"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Background="#0A0F1D"
                                     Foreground="#CBD5E1"
                                     BorderBrush="#1E2B48"
                                     BorderThickness="1"
                                     FontFamily="Consolas"
                                     FontSize="11.5"
                                     Padding="9" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- PANEL 2: NINTENDO SWITCH SCREEN STREAMING & SPLIT-SCREEN EDITOR -->
                <Border x:Name="PanelSwitch" Grid.Row="4" Style="{StaticResource CardBorder}" Padding="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Master toggle + Monitor + Quality + Live telemetry -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="CbVideoStreamEnabled" IsChecked="True" VerticalAlignment="Center"
                                      Content="Diffuser l’écran PC vers les téléphones"
                                      Foreground="#F1F5F9" FontSize="12.5" FontWeight="Bold"
                                      Checked="OnVideoEnabledChanged" Unchecked="OnVideoEnabledChanged" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="CmbMonitor" Width="165" Margin="0,0,8,0" FontSize="11.5"
                                          SelectionChanged="OnMonitorSelectionChanged" />
                                <ComboBox x:Name="CmbVideoQuality" Width="150" FontSize="11.5"
                                          SelectionChanged="OnVideoQualityChanged">
                                    <ComboBoxItem Content="Fluide (854p · 30 FPS)" IsSelected="True" />
                                    <ComboBoxItem Content="HD Net (960p · 28 FPS)" />
                                    <ComboBoxItem Content="Équilibré (720p · 24 FPS)" />
                                    <ComboBoxItem Content="Éco Wi-Fi (640p · 18 FPS)" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: 1-Click Split-Screen Presets -->
                        <Border Grid.Row="1" Background="#0D1426" BorderBrush="#1F2C4A" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="SUBDIVISION D’ÉCRAN (1 CLIC — CHAQUE JOUEUR REÇOIT SA ZONE) :"
                                           Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6" />
                                <UniformGrid Columns="6">
                                    <Button x:Name="BtnSplitFull" Content="Plein écran" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="6,6" FontSize="11" Click="OnSplitPresetFull" />
                                    <Button x:Name="BtnSplit2H" Content="2J Haut/Bas" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="6,6" FontSize="11" Click="OnSplitPreset2H" />
                                    <Button x:Name="BtnSplit2V" Content="2J Gauche/Droite" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="6,6" FontSize="11" Click="OnSplitPreset2V" />
                                    <Button x:Name="BtnSplit3" Content="3J (1+2)" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="6,6" FontSize="11" Click="OnSplitPreset3" />
                                    <Button x:Name="BtnSplit4" Content="4J Grille 2×2" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="6,6" FontSize="11" Click="OnSplitPreset4" />
                                    <Button x:Name="BtnSplitCustom" Content="Perso" Style="{StaticResource SecondaryButton}" Padding="6,6" FontSize="11" Click="OnSplitPresetCustom" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Row 2: Menu Override + Auto-Split + Rotate Views -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnMenuToggle" Content="Vue Menu : OFF" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" FontSize="11.5" Margin="0,0,10,0" Click="OnToggleMenuOverrideClick"
                                        ToolTip="Affiche temporairement tout l’écran PC à tous les joueurs (utile dans les menus avant la partie)" />
                                <CheckBox x:Name="CbAutoSplit" VerticalAlignment="Center"
                                          Content="Auto-détection Menu ↔ Match"
                                          Foreground="#CBD5E1" FontSize="11.5"
                                          Checked="OnAutoSplitChanged" Unchecked="OnAutoSplitChanged"
                                          ToolTip="Bascule automatiquement en plein écran dans les menus et revient sur chaque zone quand le split-screen démarre" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Pivoter vues ↻" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11.5"
                                        Margin="0,0,6,0" Click="OnRotateSplitViewsClick"
                                        ToolTip="Fait tourner l’attribution des zones entre les joueurs (ex. inverser J1 et J2)" />
                                <Button Content="Réinitialiser" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11.5"
                                        Click="OnResetSplitViewsClick" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Live Interactive Split-Screen Preview Canvas -->
                        <controls:SplitScreenEditorControl x:Name="SplitEditor" Grid.Row="3" MinHeight="230" />

                        <!-- Row 4: Telemetry & Drag Hint -->
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <TextBlock Text="Astuce : glisse les cadres J1–J4 (ou leur coin inférieur droit) directement sur l’aperçu pour recadrer sur mesure."
                                       Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtVideoTelemetry" Text="Moteur DXGI · 0 écran actif"
                                       Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: VIGEM + USB + BLUETOOTH/WIFI -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. ViGEmBus Xbox 360 Driver Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ViGemDot" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0" />
                                    <TextBlock Text="MANETTES XBOX 360 (J1–J4 · ViGEmBus)" Foreground="{StaticResource TextPrimary}" FontSize="11.5" FontWeight="Bold" />
                                </StackPanel>
                                <Button Content="Revérifier" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                        HorizontalAlignment="Right" Click="OnRecheckViGemClick" />
                            </Grid>

                            <TextBlock x:Name="TxtViGemStatus" Text="Vérification du pilote…"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />

                            <StackPanel x:Name="ViGemInstallPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnInstallViGem" Content="Installer le pilote Xbox 360 (ViGEmBus · 1 clic)"
                                        Style="{StaticResource PrimaryButton}" Click="OnInstallViGemClick" />
                                <TextBlock x:Name="TxtViGemProgress" Text="Requis pour les jeux multijoueur manette (FIFA, Rocket League, Mortal Kombat, émulateurs…)."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. USB Cable Hub (Priority) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="UsbDot" Width="10" Height="10" Fill="#38BDF8" Margin="0,0,8,0" />
                                    <TextBlock Text="CÂBLE USB (MANETTE &lt; 2 MS + VIDÉO)" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" />
                                </StackPanel>
                                <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                        HorizontalAlignment="Right" Click="OnRefreshUsbClick" />
                            </Grid>

                            <TextBlock x:Name="TxtAdbStatus" Text="Initialisation du pont USB…"
                                       Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtAdbDetail" Text=""
                                       Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,8" />

                            <Border Background="#0D1426" BorderBrush="#1E2B48" BorderThickness="1" CornerRadius="10" Padding="10">
                                <TextBlock Text="Le câble USB ouvre automatiquement les deux tunnels : port 27183 (manette &lt; 2 ms) et port 27185 (écran de jeu en direct) sur chaque téléphone branché !"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. Bluetooth & Network Hub -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="BtDot" Width="10" Height="10" Fill="#8B5CF6" Margin="0,0,8,0" />
                                    <TextBlock Text="BLUETOOTH &amp; WI-FI MULTIJOUEUR" Foreground="#C4B5FD" FontSize="11.5" FontWeight="Bold" />
                                </StackPanel>
                                <Button Content="Relancer BT" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                        HorizontalAlignment="Right" Click="OnRestartBluetoothClick" />
                            </Grid>

                            <TextBlock x:Name="TxtBtStatus" Text="Vérification Bluetooth…"
                                       Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtBtDetail" Text=""
                                       Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,10" />

                            <Border Background="#0D1426" BorderBrush="#1E2B48" BorderThickness="1" CornerRadius="10" Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Adresses IP PC (Manette 27183 · Vidéo Switch 27185) :"
                                                   Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" />
