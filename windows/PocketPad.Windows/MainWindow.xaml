<Window x:Class="PocketPad.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PocketPad.Windows.Controls"
        Title="PocketPad — Manette Android vers PC (USB &amp; Bluetooth)"
        Width="1040" Height="700"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgRoot}"
        Icon="Assets/icon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/icon.png" Width="38" Height="38" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PocketPad" Foreground="{StaticResource TextPrimary}" FontSize="19" FontWeight="Bold" />
                            <Border Background="#172554" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Serveur Manette PC · USB (ADB &amp; Partage) · Bluetooth · Xbox 360 &amp; Clavier/Souris"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <!-- Active Connection Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ConnectionBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="18" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,8,0" />
                            <TextBlock x:Name="ConnectionLabel" Text="En attente du téléphone…"
                                       Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnDisconnect" Content="Déconnecter" Style="{StaticResource SecondaryButton}"
                            Click="OnDisconnectClick" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 2-COLUMN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: LIVE GAMEPAD + MODE + LOGS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Live Controller Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VISUALISEUR MANETTE EN DIRECT" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="ActiveDeviceSubtitle" Text="Connecte ton téléphone en USB ou Bluetooth pour tester"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border Background="#18223A" CornerRadius="8" Padding="9,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtRate" Text="0 Hz" Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" FontWeight="Bold" />
                                </Border>
                                <Button x:Name="BtnTestRumble" Content="Tester vibration" Style="{StaticResource SecondaryButton}"
                                        Click="OnTestRumbleClick" IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <controls:GamepadVisualizer x:Name="Visualizer" />

                        <!-- Input Routing Mode Selector -->
                        <Border Background="#0D1426" BorderBrush="#1F2C4A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mode d’entrée :" Foreground="{StaticResource TextSecondary}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="RbModeAuto" Content="Auto (Xbox + Clavier/Souris)" IsChecked="True"
                                                 Foreground="#F1F5F9" FontSize="12" Margin="0,0,14,0" Checked="OnModeChanged" />
                                    <RadioButton x:Name="RbModeXbox" Content="Xbox 360"
                                                 Foreground="#F1F5F9" FontSize="12" Margin="0,0,14,0" Checked="OnModeChanged" />
                                    <RadioButton x:Name="RbModeKb" Content="Clavier/Souris"
                                                 Foreground="#F1F5F9" FontSize="12" Checked="OnModeChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Live Log Console -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="JOURNAL D’ACTIVITÉ" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                            <Button Content="Effacer" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"
                                    HorizontalAlignment="Right" Click="OnClearLogsClick" />
                        </Grid>
                        <TextBox x:Name="TxtLogs" Grid.Row="1"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Background="#0A0F1D"
                                 Foreground="#CBD5E1"
                                 BorderBrush="#1E2B48"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Padding="10" />
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: VIGEM + USB + BLUETOOTH/WIFI -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. ViGEmBus Xbox 360 Driver Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ViGemDot" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0" />
                                    <TextBlock Text="MANETTE VIRTUELLE XBOX 360 (ViGEmBus)" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                                <Button Content="Revérifier" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                        HorizontalAlignment="Right" Click="OnRecheckViGemClick" />
                            </Grid>

                            <TextBlock x:Name="TxtViGemStatus" Text="Vérification du pilote…"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />

                            <StackPanel x:Name="ViGemInstallPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnInstallViGem" Content="Installer le pilote Xbox 360 (ViGEmBus · 1 clic)"
                                        Style="{StaticResource PrimaryButton}" Click="OnInstallViGemClick" />
                                <TextBlock x:Name="TxtViGemProgress" Text="Requis uniquement pour les jeux manette Xbox 360. Le mode Clavier/Souris fonctionne déjà sans pilote."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. USB Cable Hub (Priority) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="UsbDot" Width="10" Height="10" Fill="#38BDF8" Margin="0,0,8,0" />
                                    <TextBlock Text="CONNEXION CÂBLE USB (ULTRA-RAPIDE &lt; 2 MS)" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                                <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                        HorizontalAlignment="Right" Click="OnRefreshUsbClick" />
                            </Grid>

                            <TextBlock x:Name="TxtAdbStatus" Text="Initialisation du pont USB…"
                                       Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtAdbDetail" Text=""
                                       Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,10" />

                            <Border Background="#0D1426" BorderBrush="#1E2B48" BorderThickness="1" CornerRadius="10" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="2 façons de brancher ton câble USB :" Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="1. Mode ADB direct (recommandé) : active « Débogage USB » 1 fois sur Android, branche le câble et appuie sur « Câble USB » dans PocketPad Android."
                                               Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="2. Sans options développeur : active « Partage de connexion USB » sur Android, puis appuie sur « Câble USB » — détection automatique !"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. Bluetooth & Network Hub -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="BtDot" Width="10" Height="10" Fill="#8B5CF6" Margin="0,0,8,0" />
                                    <TextBlock Text="CONNEXION BLUETOOTH &amp; RÉSEAU LOCAL" Foreground="#C4B5FD" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                                <Button Content="Relancer BT" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                        HorizontalAlignment="Right" Click="OnRestartBluetoothClick" />
                            </Grid>

                            <TextBlock x:Name="TxtBtStatus" Text="Vérification Bluetooth…"
                                       Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtBtDetail" Text=""
                                       Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,10" />

                            <Border Background="#0D1426" BorderBrush="#1E2B48" BorderThickness="1" CornerRadius="10" Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Adresses IP de ce PC (Partage USB / Wi-Fi · port 27183) :"
                                                   Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold" />
                                        <Button Content="↻" Style="{StaticResource SecondaryButton}" Padding="6,1" FontSize="11"
                                                HorizontalAlignment="Right" Click="OnRefreshIpsClick" />
                                    </Grid>
                                    <TextBlock x:Name="TxtLocalIps" Text="Recherche…"
                                               Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
