<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PocketPad.Windows</RootNamespace>
    <AssemblyName>PocketPad</AssemblyName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>PocketPad</Product>
    <Company>PocketPad</Company>
    <Description>Manette de jeu Android vers PC (USB &amp; Bluetooth) avec manette Xbox 360 virtuelle et Clavier/Souris</Description>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketPad.Core\PocketPad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <!-- Bundle Google Platform-Tools ADB binaries when staged by CI into Tools\adb\ -->
  <ItemGroup Condition="Exists('Tools\adb\adb.exe')">
    <EmbeddedResource Include="Tools\adb\adb.exe" LogicalName="PocketPad.adb.adb.exe" />
    <EmbeddedResource Include="Tools\adb\AdbWinApi.dll" LogicalName="PocketPad.adb.AdbWinApi.dll" />
    <EmbeddedResource Include="Tools\adb\AdbWinUsbApi.dll" LogicalName="PocketPad.adb.AdbWinUsbApi.dll" />
  </ItemGroup>
</Project>
