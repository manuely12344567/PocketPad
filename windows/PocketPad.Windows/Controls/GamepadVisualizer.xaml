<UserControl x:Class="PocketPad.Windows.Controls.GamepadVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="235">
    <Viewbox Stretch="Uniform">
        <Canvas Width="460" Height="240">
            <!-- Triggers LT / RT bars -->
            <Border Canvas.Left="58" Canvas.Top="8" Width="84" Height="16" CornerRadius="6"
                    Background="#18223A" BorderBrush="#2D3E63" BorderThickness="1">
                <Grid>
                    <Border x:Name="LtFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="#38BDF8" />
                    <TextBlock Text="LT" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Canvas.Left="318" Canvas.Top="8" Width="84" Height="16" CornerRadius="6"
                    Background="#18223A" BorderBrush="#2D3E63" BorderThickness="1">
                <Grid>
                    <Border x:Name="RtFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="#8B5CF6" />
                    <TextBlock Text="RT" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Bumpers LB / RB -->
            <Border x:Name="BtnLb" Canvas.Left="50" Canvas.Top="30" Width="100" Height="22" CornerRadius="8"
                    Background="#18223A" BorderBrush="#33476F" BorderThickness="1.2">
                <TextBlock Text="LB" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border x:Name="BtnRb" Canvas.Left="310" Canvas.Top="30" Width="100" Height="22" CornerRadius="8"
                    Background="#18223A" BorderBrush="#33476F" BorderThickness="1.2">
                <TextBlock Text="RB" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Controller chassis silhouette -->
            <Border Canvas.Left="28" Canvas.Top="56" Width="404" Height="166" CornerRadius="68"
                    Background="#131D33" BorderBrush="#2B3D63" BorderThickness="2" />

            <!-- Left Analog Stick -->
            <Ellipse x:Name="LeftStickRing" Canvas.Left="68" Canvas.Top="82" Width="74" Height="74"
                     Fill="#0D1426" Stroke="#33476F" StrokeThickness="2" />
            <Ellipse x:Name="LeftStickKnob" Canvas.Left="88" Canvas.Top="102" Width="34" Height="34"
                     Fill="#25365A" Stroke="#38BDF8" StrokeThickness="2" />

            <!-- D-Pad -->
            <Border x:Name="BtnDpadUp" Canvas.Left="158" Canvas.Top="138" Width="22" Height="22" CornerRadius="4"
                    Background="#1B2742" BorderBrush="#33476F" BorderThickness="1">
                <TextBlock Text="▲" Foreground="#CBD5E1" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnDpadDown" Canvas.Left="158" Canvas.Top="182" Width="22" Height="22" CornerRadius="4"
                    Background="#1B2742" BorderBrush="#33476F" BorderThickness="1">
                <TextBlock Text="▼" Foreground="#CBD5E1" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnDpadLeft" Canvas.Left="136" Canvas.Top="160" Width="22" Height="22" CornerRadius="4"
                    Background="#1B2742" BorderBrush="#33476F" BorderThickness="1">
                <TextBlock Text="◀" Foreground="#CBD5E1" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnDpadRight" Canvas.Left="180" Canvas.Top="160" Width="22" Height="22" CornerRadius="4"
                    Background="#1B2742" BorderBrush="#33476F" BorderThickness="1">
                <TextBlock Text="▶" Foreground="#CBD5E1" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Center Buttons: Back / Guide / Start -->
            <Border x:Name="BtnBack" Canvas.Left="172" Canvas.Top="95" Width="32" Height="18" CornerRadius="9"
                    Background="#1B2742" BorderBrush="#33476F" BorderThickness="1">
                <TextBlock Text="SEL" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnGuide" Canvas.Left="213" Canvas.Top="84" Width="34" Height="34" CornerRadius="17"
                    Background="#18223A" BorderBrush="#38BDF8" BorderThickness="1.8">
                <TextBlock Text="⚡" Foreground="#38BDF8" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnStart" Canvas.Left="256" Canvas.Top="95" Width="32" Height="18" CornerRadius="9"
                    Background="#1B2742" BorderBrush="#33476F" BorderThickness="1">
                <TextBlock Text="STR" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Right Analog Stick -->
            <Ellipse x:Name="RightStickRing" Canvas.Left="252" Canvas.Top="136" Width="74" Height="74"
                     Fill="#0D1426" Stroke="#33476F" StrokeThickness="2" />
            <Ellipse x:Name="RightStickKnob" Canvas.Left="272" Canvas.Top="156" Width="34" Height="34"
                     Fill="#25365A" Stroke="#8B5CF6" StrokeThickness="2" />

            <!-- Face Buttons Y / X / B / A -->
            <Border x:Name="BtnY" Canvas.Left="350" Canvas.Top="70" Width="30" Height="30" CornerRadius="15"
                    Background="#1B2742" BorderBrush="#EAB308" BorderThickness="1.8">
                <TextBlock Text="Y" Foreground="#FACC15" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnX" Canvas.Left="320" Canvas.Top="100" Width="30" Height="30" CornerRadius="15"
                    Background="#1B2742" BorderBrush="#38BDF8" BorderThickness="1.8">
                <TextBlock Text="X" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnB" Canvas.Left="380" Canvas.Top="100" Width="30" Height="30" CornerRadius="15"
                    Background="#1B2742" BorderBrush="#F43F5E" BorderThickness="1.8">
                <TextBlock Text="B" Foreground="#FB7185" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnA" Canvas.Left="350" Canvas.Top="130" Width="30" Height="30" CornerRadius="15"
                    Background="#1B2742" BorderBrush="#22C55E" BorderThickness="1.8">
                <TextBlock Text="A" Foreground="#4ADE80" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Canvas>
    </Viewbox>
</UserControl>
